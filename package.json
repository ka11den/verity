{
	"name": "verity",
	"version": "1.0.0",
	"description": "lightweight, type-safe schema validation library with TypeScript static type inference",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --clean && tsc --emitDeclarationOnly",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
	},
	"keywords": [
		"schema",
		"validation",
		"validator",
		"typescript",
		"type-safety",
		"zod-alternative"
	],
	"author": "ka11den",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
